# Локальная PostgreSQL. Пароль задайте самостоятельно, не публикуйте .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=alfa_news
POSTGRES_USER=alfa_user
POSTGRES_PASSWORD=
# DATABASE_URL приоритетнее отдельных настроек (пароль в URI требует URL-кодирования).
DATABASE_URL=
# Для Docker задайте только если нужна отдельная полная URI; иначе используются параметры выше.
DOCKER_DATABASE_URL=
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000
# Локальный лимит транзакции CSV-импорта; не меняет таймаут API.
IMPORT_STATEMENT_TIMEOUT_MS=600000

# Явно разрешённые CLIENT-компании демо. Это не пользовательская авторизация.
DEMO_COMPANY_IDS=U_44564,U_19717,U_9250
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RELATIONS_LIMIT=200
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Локально CSV размещаются в data/raw/, в Docker — /app/data/raw.
DATA_DIR=data/raw
DOCKER_DATA_DIR=/app/data/raw

# Пустой модуль означает: ML отключён, реальные запросы не выполняются.
# Пример после интеграции: ML_ADAPTER_MODULE=team_ml.adapter
ML_ADAPTER_MODULE=
# Base URL и ключ выдаются организаторами; заполнить перед подключением ML.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Gemma-4-26B-A4B
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
MAX_ANALYSIS_ATTEMPTS=3
ANALYSIS_LEASE_SECONDS=900
# Локальный JSON-манифест проверенных документов/страниц, не произвольный URL.
BANK_MATERIALS_PATH=
# Только для нестандартного манифеста внутри контейнера; обычно оставить пустым.
DOCKER_BANK_MATERIALS_PATH=

# Ручной сбор новостей. Запись в PostgreSQL только без --dry-run.
NEWS_SOURCES=cbr,government
NEWS_GOVERNMENT_RSS_URL=http://government.ru/all/rss/
NEWS_INTERFAX_RSS_URL=https://www.interfax.ru/rss
NEWS_FINMARKET_RSS_URL=https://www.finmarket.ru/rss/mainnews.asp
NEWS_CBR_RSS_URL=https://www.cbr.ru/rss/RssPress
NEWS_MINFIN_RSS_URL=https://minfin.gov.ru/rss_news?mod=news&lim=50
NEWS_FNS_RSS_URL=https://www.nalog.gov.ru/rn77/rss/
NEWS_LIMIT=3
NEWS_POLL_SECONDS=1800
NEWS_TIMEOUT_SECONDS=20
NEWS_MAX_RESPONSE_BYTES=2000000
NEWS_USER_AGENT=AlfaHackNewsCollector/1.0
NEWS_REQUEST_DELAY_SECONDS=1
NEWS_MAX_AGE_DAYS=30
NEWS_MIN_TEXT_CHARS=120
# Необязательный отбор по подстрокам, через запятую (OR), без ML.
NEWS_KEYWORDS=

# Фоновый ранкер читает реальные новости из PostgreSQL после сборщика.
# Вызывает внешний LLM для каждой компании/роли. Включать после согласования.
NEWS_RANK_ENABLED=false
NEWS_RANK_LIMIT=3
NEWS_RANK_POLL_SECONDS=600
# Синтетические новости сохранены в БД, но скрыты из обычной ленты.
FEED_INCLUDE_SYNTHETIC=false

# Постоянное локальное состояние RAG; исходные PDF не отправляются автоматически.
BANK_PDF_DIR=data/raw/bank_analytics
CHROMA_DB_DIR=data/chroma_db
OCR_CACHE_DIR=data/ocr_cache
HF_HOME=data/model_cache
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Необязательные модели операций; пусто = LLM_MODEL. Только согласованные имена.
LLM_RANK_MODEL=
LLM_CHAT_MODEL=
LLM_OCR_MODEL=Qwen3-VL-30B-A3B-Instruct
RAG_TOP_K=3
