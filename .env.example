# Ключ и базовый URL для доступа к разрешенным LLM хакатона
LLM_API_KEY=0
LLM_BASE_URL=0

# Разрешенные модели по ТЗ
MODEL_FAST=Gemma-4-26B-A4B
MODEL_SMART=GLM-5.3-Flash
MODEL_UNIVERSAL=Qwen3.6-35B-A3B
MODEL_RESEARCH=DeepSeek-V4.1-Flash
MODEL_TEXT=Kimi-K2.6
MODEL_VISION=Qwen3-VL-30B-A3B-Instruct

# Настройки приложения
BACKEND_PORT=8000
FRONTEND_PORT=3000
ENABLE_LLM_CACHE=true
# PostgreSQL: локальный запуск импортёра (DATABASE_URL имеет приоритет)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=alfa_news
POSTGRES_USER=alfa_user
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://user:URL_ENCODED_PASSWORD@host:port/database
# DATA_DIR=/absolute/path/to/data
# Для Docker: при спецсимволах в пароле задайте URL с percent-encoding.
# DOCKER_DATABASE_URL=postgresql://alfa_user:URL_ENCODED_PASSWORD@db:5432/alfa_news
