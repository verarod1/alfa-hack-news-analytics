# Локальная PostgreSQL. Пароль задайте самостоятельно, не публикуйте .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=alfa_news
POSTGRES_USER=alfa_user
POSTGRES_PASSWORD=
# DATABASE_URL приоритетнее отдельных настроек (пароль в URI требует URL-кодирования).
DATABASE_URL=
# Для Docker задайте только если нужна отдельная полная URI; иначе используются параметры выше.
DOCKER_DATABASE_URL=
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000

# Явно разрешённые CLIENT-компании демо. Это не пользовательская авторизация.
DEMO_COMPANY_IDS=U_81
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RELATIONS_LIMIT=200
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Пустое значение использует каталог data в корне проекта.
DATA_DIR=

# Пустой модуль означает: ML отключён, реальные запросы не выполняются.
# Пример после интеграции: ML_ADAPTER_MODULE=team_ml.adapter
ML_ADAPTER_MODULE=
# Base URL и ключ выдаются организаторами; заполнить перед подключением ML.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Gemma-4-26B-A4B
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
MAX_ANALYSIS_ATTEMPTS=3
ANALYSIS_LEASE_SECONDS=900
# Локальный JSON-манифест проверенных документов/страниц, не произвольный URL.
BANK_MATERIALS_PATH=
